              "type": "choice",
              "values": [[1, "100 %"], [1.25, "125 %"], [1.5, "150 %"]],
              "help": "Субтитры, подсказки, меню и сообщения."
            },
            {
              "key": "hudScale",
              "label": "Масштаб HUD",
              "type": "slider",
              "min": 0.8,
              "max": 1.3,
              "step": 0.05,
              "help": "Размер приборов в полёте: кольцо, радар, шкалы."
