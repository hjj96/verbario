    "derived": {
      "qualityTiers": {
        "low": {"pixelRatioCap": 1, "detail": 0.35},
        "medium": {"pixelRatioCap": 1.25, "detail": 0.65},
        "high": {"pixelRatioCap": 2, "detail": 1}
      },
      "autoAssist": {
        "rule": "difficulty === 'cadet' || coarse pointer (touch) ? 'full' : 'standard' — only while assistExplicit is false",
        "nonTouch": {"cadet": "full", "pilot": "standard", "ace": "standard"}
      },
      "migrations": [
        {
          "key": "assistExplicit",
          "rule": "saved settings without assistExplicit: true when saved.assist exists and !== 'standard'"
        }
      ],
      "firstRun": [
        {
          "when": "no saved settings && prefers-reduced-motion: reduce",
          "set": "reduceMotion-related defaults (see core/settings.js constructor)"
        },
        {"when": "no saved settings && pointer: coarse", "set": {"quality": "low"}},
        {"when": "URL ?quality=low|medium|high", "set": "quality"}
      ]
    }
  }
