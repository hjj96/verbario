    "mission/report": {
      "MEDAL_LABEL": {"bronze": "Бронза", "silver": "Серебро", "gold": "Золото", "cross": "Крест"},
      "FAIL_TEXT": {
        "crash": "АВАРИЙНОЕ ПРИВОДНЕНИЕ",
        "ditch": "АВАРИЙНОЕ ПРИВОДНЕНИЕ",
        "abort": "ОТБОЙ ОПЕРАЦИИ",
        "time": "ВРЕМЯ ВЫШЛО",
        "lost": "СМЕНА ОКОНЧЕНА",
        "quit": "СМЕНА СДАНА"
      },
      "REMARKS": [
        {
          "when": {"fn": "when", "src": "(r) => r.reason === 'crash'"},
          "speaker": "pilot",
          "name": "Гордеев",
          "text": "Машину жалко. Людей — нет: все живы. Это главное."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.reason === 'ditch'"},
          "speaker": "winchman",
          "name": "Семёныч",
          "text": "Говорил же: бинго — значит бинго. Ладно. Искупались."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.endless && r.rescued >= 20"},
          "speaker": "dispatch",
          "name": "Берег",
          "text": "Смена сдана. Двадцать с лишним человек дома. Спасибо, Чайка. Отдыхайте."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.endless"},
          "speaker": "dispatch",
          "name": "Берег",
          "text": "Смена сдана. Спасибо, Чайка. Катера продолжают работу."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.reason === 'abort' || r.reason === 'time'"},
          "speaker": "pilot",
          "name": "Гордеев",
          "text": "Не всех. Но и не никого. Пошли писать рапорт."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.damage >= 0.5"},
          "speaker": "winchman",
          "name": "Семёныч",
          "text": "Вертолёт — на ремонт, командира — на беседу."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.styleIds.includes('lastDrops')"},
          "speaker": "pilot",
          "name": "Гордеев",
          "text": "Сели на парах. Больше так не делай. Пожалуйста."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.styleIds.includes('paws')"},
          "speaker": "rescuer",
          "name": "Костя",
          "text": "Кот, кстати, так и не сказал спасибо."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.styleIds.includes('bottle')"},
          "speaker": "rescuer",
          "name": "Костя",
          "text": "Записку я забираю. Повешу над койкой — пусть кто-нибудь и нам напишет."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.jewels >= 3"},
          "speaker": "winchman",
          "name": "Семёныч",
          "text": "Висели как люстра. Красиво."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.success && r.damage <= 1e-6"},
          "speaker": "winchman",
          "name": "Семёныч",
          "text": "Даже чай не расплескали."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.styleIds.includes('stormDeck')"},
          "speaker": "winchman",
          "name": "Семёныч",
          "text": "Сели на палубу, как кот на забор. Уважаю."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.styleIds.includes('lightning')"},
          "speaker": "pilot",
          "name": "Гордеев",
          "text": "Рядом шарахнуло, а приборы живы. И мы живы."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.lost > 0"},
          "speaker": "pilot",
          "name": "Гордеев",
          "text": "Не всех… Ладно. Работаем дальше."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.par && r.time < r.par * 0.75"},
          "speaker": "pilot",
          "name": "Гордеев",
          "text": "Быстро. Берег спрашивает, не перепутали ли мы район."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.tags.includes('fog')"},
          "speaker": "pilot",
          "name": "Гордеев",
          "text": "Летели на ощупь, как в погреб за картошкой. Но нашли."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.tags.includes('eye')"},
          "speaker": "rescuer",
          "name": "Костя",
          "text": "Небо было голубое ровно минуту. Я засёк."
        },
        {
          "when": {"fn": "when", "src": "(r) => r.tags.includes('night')"},
          "speaker": "rescuer",
          "name": "Костя",
          "text": "Вода плюс семь. Напоминаю: я на это не подписывался. А, нет, подписывался."
        },
        {
          "when": {"fn": "when", "src": "() => true"},
          "speaker": "winchman",
          "name": "Семёныч",
          "text": "Вот вернёмся — борща. И спать. Именно в таком порядке."
        }
      ]
    },
