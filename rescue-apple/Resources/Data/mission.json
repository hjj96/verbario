      "ORDER": ["delivered", "warmth", "golden", "style", "time", "lost", "damage", "autorotation"],
      "LABELS": {
        "delivered": "Доставлено людей",
        "warmth": "Тепло при подъёме",
        "golden": "«Золотой час»",
        "style": "Стиль",
        "time": "Быстрее пара",
        "lost": "Потеряно людей",
        "damage": "Повреждения корпуса",
        "autorotation": "Посадка на авторотации"
      },
      "CHAIN_WINDOW": 20
    },
    "derived": {
      "rules": {
        "medalsFor": "function medalsFor({ success, ratio, time, par, styles, damage }) {\n  const bronze = !!success && ratio >= 0.6 - 1e-9;\n  const silver = bronze && ratio >= 0.85 - 1e-9 && (!par || time <= par * 1.3);\n  const gold = silver && ratio >= 1 - 1e-9 && (!par || time <= par) && styles >= 2;\n  const cross = gold && damage <= 1e-6;\n  return { bronze, silver, gold, cross, rings: (bronze ? 1 : 0) + (silver ? 1 : 0) + (gold ? 1 : 0) };\n}",
        "styleChain": "chainable style within CHAIN_WINDOW s of the previous one: chain++, else chain = 0; points = round(base · min(2, 1.2^chain)); once-styles count once; chain:false styles never chain",
        "final": "max(0, round(raw · DIFFICULTY[d].mult))"
      }
    }
  }
}
