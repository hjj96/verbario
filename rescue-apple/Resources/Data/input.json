    "core/haptics": {
      "RULES": {
        "heli:damage": {"fn": "heli:damage", "src": "(p) => [Math.min(1, 0.35 + (p.amount || 0) * 3), 220]"},
        "heli:water-strike": {"fn": "heli:water-strike", "src": "() => [0.45, 160]"},
        "heli:touchdown": {"fn": "heli:touchdown", "src": "() => [0.25, 90]"},
        "heli:land": {"fn": "heli:land", "src": "(p) => [p.autorotation ? 0.7 : 0.2, 120]"},
        "heli:crash": {"fn": "heli:crash", "src": "() => [1, 700]"},
        "heli:capture": {"fn": "heli:capture", "src": "() => [0.2, 80]"},
        "heli:pickup": {"fn": "heli:pickup", "src": "() => [0.3, 110]"},
        "heli:slip": {"fn": "heli:slip", "src": "() => [0.5, 200]"},
        "heli:snag": {"fn": "heli:snag", "src": "() => [0.6, 260]"},
        "hazard:hit": {"fn": "hazard:hit", "src": "(p) => [Math.min(1, 0.5 + (p.damage || 0) * 2), 320]"},
        "weather:gust": {
          "fn": "weather:gust",
          "src": "(p) => (p.harmless ? null : [Math.min(0.5, (p.strength || 8) / 30), 260])"
        },
        "weather:lightning": {
          "fn": "weather:lightning",
          "src": "(p) => (p.cloudOnly || (p.distance ?? 1e9) > 600 ? null : [Math.max(0.15, 0.7 - p.distance / 900), 240])"
        }
      }
